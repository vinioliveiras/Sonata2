#!/bin/sh
# Sonata session: apps that run in a terminal (Vim, Micro, htop... entries
# with Terminal=true) open in Sonata's Terminal. GLib and other launchers ask
# `xdg-terminal-exec` first; tools/session-env.sh puts this folder first in PATH.
#   xdg-terminal-exec [--app-id=X] [--title=X] [-e] [cmd args...]
while [ $# -gt 0 ]; do
    case "$1" in --app-id=*|--title=*) shift ;; *) break ;; esac
done
[ "${1:-}" = -e ] && shift
[ $# -eq 0 ] && exec sonata2-rs terminal
# one shell-quoted line, as Terminal's --exec takes it
cmd=""
for a in "$@"; do cmd="$cmd '$(printf %s "$a" | sed "s/'/'\\\\''/g")'"; done
exec sonata2-rs terminal --exec "${cmd# }"
