#!/usr/bin/env bash
# Start a full Sonata session (what the display manager's "Sonata" entry
# runs; see session/sonata2.desktop). Uses ~/.config/wayfire.ini when it
# exists, else the repo's config/wayfire.ini.
source "$(dirname "$(readlink -f "$0")")/session-env.sh"
export XDG_CURRENT_DESKTOP=Sonata XDG_SESSION_DESKTOP=sonata
cfg="$HOME/.config/wayfire.ini"
[ -f "$cfg" ] || cfg="$SONATA_REPO/config/wayfire.ini"
exec wayfire -c "$cfg"
