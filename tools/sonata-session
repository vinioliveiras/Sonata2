#!/usr/bin/env bash
# Start a full Sonata session (what the login screen's "Sonata" entry runs,
# through the `sonata-session` launcher from install.sh).
# no console text shows around the login (greetd's VT)
[ -t 1 ] && printf '\033c\033[?25l'
# login.log: every traced line with its time (where a slow login waits)
PS4='+ $(date +%T.%3N) '
source "$(dirname "$(readlink -f "$0")")/session-env.sh"
export XDG_CURRENT_DESKTOP=Sonata XDG_SESSION_DESKTOP=sonata
# Session config from install.sh (never your ~/.config/wayfire.ini).
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/sonata2/wayfire.ini"
mark="${XDG_CONFIG_HOME:-$HOME/.config}/sonata2/.wayfire.ini.installed"
# An untouched copy follows Sonata's current default (updates need no
# reinstall); a copy you edited is used as it is.
if [ ! -f "$cfg" ] || { [ -f "$mark" ] && cmp -s "$cfg" "$mark"; }; then
    cfg="$SONATA_REPO/config/wayfire.ini"
fi
# Resolved copy: Sonata paths filled in, pixdecor title bars when installed.
run_cfg="${XDG_RUNTIME_DIR:-/tmp}/sonata2-wayfire.ini"
"$(dirname "$(readlink -f "$0")")/wayfire-config.sh" "$cfg" "$run_cfg" && cfg="$run_cfg"
# Polkit authentication agent (password prompts for system actions):
# Sonata's own (started by `sonata2 autostart`) when polkit's
# introspection data is there; otherwise the first other agent installed.
sonata_agent=""
for t in /usr/lib/girepository-1.0 /usr/lib64/girepository-1.0 /usr/lib/*/girepository-1.0; do
    [ -f "$t/PolkitAgent-1.0.typelib" ] && sonata_agent=1
done
[ -n "$sonata_agent" ] || for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
             /usr/libexec/polkit-gnome-authentication-agent-1 \
             /usr/lib/x86_64-linux-gnu/polkit-gnome-authentication-agent-1 \
             /usr/lib/polkit-kde-authentication-agent-1 /usr/libexec/polkit-kde-authentication-agent-1 \
             /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 /usr/libexec/polkit-mate-authentication-agent-1 \
             /usr/bin/lxqt-policykit-agent /usr/lib/xfce-polkit/xfce-polkit /usr/libexec/xfce-polkit; do
    [ -x "$agent" ] && { "$agent" & break; }
done
# Saved passwords (Chrome, VS Code, Wi-Fi secrets): the login screen's PAM
# usually unlocks gnome-keyring; make sure its secrets service runs.
# KeePassXC is Sonata's keyring when installed (sonata2/keyring.py turns on
# its Secret Service and starts it at login); gnome-keyring only without it.
if ! command -v keepassxc >/dev/null && command -v gnome-keyring-daemon >/dev/null; then
    eval "$(gnome-keyring-daemon --start --components=secrets,pkcs11 2>/dev/null)" || true
    export SSH_AUTH_SOCK
fi
# Session log (Wayfire + every Sonata component started from it); the
# previous one is kept as session.old.log.
logs="${XDG_CACHE_HOME:-$HOME/.cache}/sonata2"; mkdir -p "$logs"
[ -f "$logs/session.log" ] && mv -f "$logs/session.log" "$logs/session.old.log"
# Detailed logs (sonata2/logs.py): a dev install (git clone), the flag file
# (Settings > About: click the version 7 times) or SONATA_DEBUG=1. Otherwise
# Wayfire's info lines are left out and the log stops growing at 4 MB --
# errors and crashes, what `sonata2 doctor` needs.
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if [ "${SONATA_DEBUG:-}" = 1 ] || [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/sonata2/debug-logging" ] || [ -d "$here/.git" ]; then
    session_log() { cat > "$1"; }
else
    session_log() { awk '!/^II / { n += length($0) + 1; if (n <= 4194304) { print; fflush() } }' > "$1"; }
fi
# The login intro (sonata2/shell/intro.py): the welcome screen, then the
# Dock and menu bar slide in. Only at login, never on a restart of Sonata.
touch "${XDG_RUNTIME_DIR:-/tmp}/sonata2-intro"
# Portals still running from the previous session (another desktop's
# environment) would pick that desktop's backends (GNOME's waits ~25 s for
# gnome-shell) and hold every GTK process at startup: they start again,
# on first use, with this session's environment -- handed over now, before
# any Sonata surface asks for them (WAYLAND_DISPLAY follows from Wayfire).
if command -v systemctl >/dev/null; then
    systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gnome.service \
        xdg-desktop-portal-gtk.service xdg-desktop-portal-kde.service 2>/dev/null || true
fi
command -v dbus-update-activation-environment >/dev/null && \
    dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_DATA_DIRS \
        DCONF_PROFILE XCURSOR_THEME XCURSOR_SIZE XCURSOR_PATH QT_QPA_PLATFORMTHEME 2>/dev/null || true
# Hybrid laptops: draw with the GPU the displays are connected to. wlroots
# renders on the first GPU it finds -- often the integrated one -- and then
# copies every frame to the other GPU's screens (a 180 Hz external display
# and a 144 Hz panel on the NVIDIA card, drawn by the Radeon 680M: animations
# fell to 60-90 fps). SONATA_PRIMARY_GPU=off keeps wlroots' own choice.
gpu_set=""
if [ -z "${WLR_DRM_DEVICES:-}" ] && [ "${SONATA_PRIMARY_GPU:-auto}" != off ]; then
    best=""; best_n=0; all=""
    for card in /sys/class/drm/card[0-9]; do
        [ -e "$card/device" ] || continue
        n=0
        for st in "$card"-*/status; do
            [ -f "$st" ] && [ "$(cat "$st" 2>/dev/null)" = connected ] && n=$((n + 1))
        done
        dev="/dev/dri/$(basename "$card")"
        all="$all $dev"
        if [ "$n" -gt "$best_n" ]; then best="$dev"; best_n=$n; fi
    done
    if [ -n "$best" ] && [ "$(echo $all | wc -w)" -gt 1 ]; then
        order="$best"
        for dev in $all; do [ "$dev" = "$best" ] || order="$order:$dev"; done
        export WLR_DRM_DEVICES="$order"
        gpu_set=1
    fi
fi
if [ -n "$gpu_set" ]; then
    # a GPU order the session can't start with (driver trouble) must never
    # lock you out: Wayfire ending within seconds is started again without it
    started=$(date +%s)
    wayfire -c "$cfg" > >(session_log "$logs/session.log") 2>&1
    code=$?
    if [ $(( $(date +%s) - started )) -ge 15 ]; then
        exit $code
    fi
    mv -f "$logs/session.log" "$logs/session.gpu-failed.log"
    unset WLR_DRM_DEVICES
fi
exec wayfire -c "$cfg" > >(session_log "$logs/session.log") 2>&1
