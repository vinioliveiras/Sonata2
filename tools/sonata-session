#!/usr/bin/env bash
# Start a full Sonata session (what the login screen's "Sonata" entry runs,
# through the `sonata-session` launcher from install.sh).
# no console text shows around the login (greetd's VT)
[ -t 1 ] && printf '\033c\033[?25l'
# login.log: every traced line with its time (where a slow login waits)
PS4='+ $(date +%T.%3N) '
source "$(dirname "$(readlink -f "$0")")/session-env.sh"
export XDG_CURRENT_DESKTOP=Sonata XDG_SESSION_DESKTOP=sonata
# Session config from install.sh (never your ~/.config/wayfire.ini).
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/sonata2/wayfire.ini"
mark="${XDG_CONFIG_HOME:-$HOME/.config}/sonata2/.wayfire.ini.installed"
# An untouched copy follows Sonata's current default (updates need no
# reinstall); a copy you edited is used as it is.
if [ ! -f "$cfg" ] || { [ -f "$mark" ] && cmp -s "$cfg" "$mark"; }; then
    cfg="$SONATA_REPO/config/wayfire.ini"
fi
# Resolved copy: Sonata paths filled in, pixdecor title bars when installed.
run_cfg="${XDG_RUNTIME_DIR:-/tmp}/sonata2-wayfire.ini"
"$(dirname "$(readlink -f "$0")")/wayfire-config.sh" "$cfg" "$run_cfg" && cfg="$run_cfg"
# Sonata's Wayfire with the fix for buffers the GPU refuses (tools/build-wayfire.sh),
# while it's built from the installed Wayfire's commit (its plugins match)
WAYFIRE=wayfire
own="${SONATA_WAYFIRE_PREFIX:-$HOME/.local/opt/sonata-wayfire}"
# ($own/failed: it couldn't start once -- the system's until it's built again)
# ($own/standalone: Wayfire 0.12 built where the distro's is older --
#  tools/build-wayfire-stack.sh -- used whatever the system's version is)
if [ -x "$own/bin/wayfire" ] && [ -s "$own/standalone" ] && [ ! -e "$own/failed" ] &&
        [ "${SONATA_SYSTEM_WAYFIRE:-}" != 1 ]; then
    WAYFIRE="$own/bin/wayfire"           # (never the system's plugins: they're for its older Wayfire)
elif [ -x "$own/bin/wayfire" ] && [ -s "$own/sonata-commit" ] && [ ! -e "$own/failed" ] &&
        [ "${SONATA_SYSTEM_WAYFIRE:-}" != 1 ] &&
        wayfire --version 2>/dev/null | grep -q -- "-$(head -n1 "$own/sonata-commit") "; then
    WAYFIRE="$own/bin/wayfire"
    # plugins installed only system-wide, and their settings (pixdecor.xml: without
    # it Wayfire aborted at once -- Vini's screen flickered), linked in
    for d in lib/wayfire share/wayfire/metadata; do
        mkdir -p "$own/$d"
        for f in /usr/$d/*; do
            [ -e "$f" ] && [ ! -e "$own/$d/${f##*/}" ] && ln -s "$f" "$own/$d/${f##*/}" 2>/dev/null
        done
    done
fi
# Polkit authentication agent (password prompts for system actions):
# Sonata's own (started by `sonata2 autostart`) when polkit's
# introspection data is there; otherwise the first other agent installed.
sonata_agent=""
for t in /usr/lib/girepository-1.0 /usr/lib64/girepository-1.0 /usr/lib/*/girepository-1.0; do
    [ -f "$t/PolkitAgent-1.0.typelib" ] && sonata_agent=1
done
[ -n "$sonata_agent" ] || for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
             /usr/libexec/polkit-gnome-authentication-agent-1 \
             /usr/lib/x86_64-linux-gnu/polkit-gnome-authentication-agent-1 \
             /usr/lib/polkit-kde-authentication-agent-1 /usr/libexec/polkit-kde-authentication-agent-1 \
             /usr/lib/mate-polkit/polkit-mate-authentication-agent-1 /usr/libexec/polkit-mate-authentication-agent-1 \
             /usr/bin/lxqt-policykit-agent /usr/lib/xfce-polkit/xfce-polkit /usr/libexec/xfce-polkit; do
    [ -x "$agent" ] && { "$agent" & break; }
done
# Saved passwords (Chrome, VS Code, Wi-Fi secrets): GNOME's keyring, unlocked
# by the login screen's PAM with your password (no prompt); make sure its
# secrets service runs. KeePassXC instead while it is still your keyring
# (sonata2/keyring.py: backend; it starts KeePassXC at login).
keyring_backend="$(PYTHONPATH="$SONATA_REPO" python3 -m sonata2 keyring backend 2>/dev/null || echo gnome)"
if [ "$keyring_backend" != keepassxc ] && command -v gnome-keyring-daemon >/dev/null; then
    eval "$(gnome-keyring-daemon --start --components=secrets,pkcs11 2>/dev/null)" || true
    export SSH_AUTH_SOCK
fi
# Session log (Wayfire + every Sonata component started from it); the
# previous one is kept as session.old.log.
logs="${XDG_CACHE_HOME:-$HOME/.cache}/sonata2"; mkdir -p "$logs"
[ -f "$logs/session.log" ] && mv -f "$logs/session.log" "$logs/session.old.log"
# The login intro (sonata2/shell/intro.py): the welcome screen, then the
# Dock and menu bar slide in. Only at login, never on a restart of Sonata.
touch "${XDG_RUNTIME_DIR:-/tmp}/sonata2-intro"
# Portals still running from the previous session (another desktop's
# environment) would pick that desktop's backends (GNOME's waits ~25 s for
# gnome-shell) and hold every GTK process at startup: they start again,
# on first use, with this session's environment -- handed over now, before
# any Sonata surface asks for them (WAYLAND_DISPLAY follows from Wayfire).
if command -v systemctl >/dev/null; then
    systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-gnome.service \
        xdg-desktop-portal-gtk.service xdg-desktop-portal-kde.service 2>/dev/null || true
fi
command -v dbus-update-activation-environment >/dev/null && \
    dbus-update-activation-environment --systemd XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_DATA_DIRS \
        DCONF_PROFILE XCURSOR_THEME XCURSOR_SIZE XCURSOR_PATH QT_QPA_PLATFORMTHEME SONATA_GLASS 2>/dev/null || true
# Hybrid laptops: draw with the GPU the displays are connected to. wlroots
# renders on the first GPU it finds -- often the integrated one -- and then
# copies every frame to the other GPU's screens (a 180 Hz external display
# and a 144 Hz panel on the NVIDIA card, drawn by the Radeon 680M: animations
# fell to 60-90 fps). Off by default: Wayfire on NVIDIA's GBM crashed the
# whole session back to the login screen ("gbm_bo_create failed: Invalid
# argument" for a window's or the blur's buffer). Turned on in Settings >
# Displays (the flag file) or with SONATA_PRIMARY_GPU=on; SONATA_PRIMARY_GPU=off
# keeps wlroots' own choice.
gpu_set=""; display_gpu=""
gpu_flag="${XDG_CONFIG_HOME:-$HOME/.config}/sonata2/compositor-display-gpu"
# the cards, their connected screens, and which are NVIDIA's
best=""; best_n=0; all=""; total=0; nv_cards=""; other_cards=""; other_n=0
for card in /sys/class/drm/card[0-9]; do
    [ -e "$card/device" ] || continue
    n=0
    for st in "$card"-*/status; do
        [ -f "$st" ] && [ "$(cat "$st" 2>/dev/null)" = connected ] && n=$((n + 1))
    done
    dev="/dev/dri/$(basename "$card")"
    all="$all $dev"
    total=$((total + n))
    if [ "$n" -gt "$best_n" ]; then best="$dev"; best_n=$n; fi
    case "$(basename "$(readlink -f "$card/device/driver")")" in
        nvidia*) nv_cards="${nv_cards:+$nv_cards:}$dev" ;;
        *) other_cards="${other_cards:+$other_cards:}$dev"; other_n=$((other_n + n)) ;;
    esac
done
# An integrated GPU with no screen of its own (a MUX in dGPU / "Ultimate"
# mode) never draws the session, whatever the setting (Vini: every AMD
# crash came from drawing there and copying to the NVIDIA screens; a crash
# that turned the setting off sent the next login back to it)
no_screens_gpu=""
[ -n "$nv_cards" ] && [ -n "$other_cards" ] && [ "$other_n" -eq 0 ] && [ "$best_n" -gt 0 ] && no_screens_gpu=1
if [ -z "${WLR_DRM_DEVICES:-}" ] && { [ "${SONATA_PRIMARY_GPU:-}" = on ] || \
        { [ "${SONATA_PRIMARY_GPU:-}" != off ] && { [ -e "$gpu_flag" ] || [ -n "$no_screens_gpu" ]; }; }; }; then
    if [ -n "$best" ] && [ "$(echo $all | wc -w)" -gt 1 ]; then
        order="$best"
        # every screen on that GPU (a MUX in dGPU / "Ultimate" mode): the
        # others are left out, so their driver can't take the session down
        # (Vini: a Radeon 680M page fault in the copies crashed Wayfire with
        # nothing on its screens). SONATA_KEEP_ALL_GPUS=1 keeps them (a
        # display plugged into the other GPU then shows up without a new login).
        if [ "$best_n" -lt "$total" ] || [ "${SONATA_KEEP_ALL_GPUS:-}" = 1 ]; then
            for dev in $all; do [ "$dev" = "$best" ] || order="$order:$dev"; done
        fi
        export WLR_DRM_DEVICES="$order"
        gpu_set=1
        display_gpu=1
    fi
elif [ -z "${WLR_DRM_DEVICES:-}" ] && [ "${SONATA_PRIMARY_GPU:-}" != off ]; then
    # Default, when the integrated GPU has screens of its own (hybrid mode):
    # it draws, the NVIDIA cards go last (wlroots would pick the boot GPU,
    # NVIDIA on some laptops -- buffer crashes there). With no screen on it,
    # the branch above already left it out.
    if [ -n "$other_cards" ] && [ -n "$nv_cards" ]; then
        export WLR_DRM_DEVICES="$other_cards:$nv_cards"
        gpu_set=1
    fi
fi
# Sonata crashed (not a log-out, nor the shutdown's SIGTERM / SIGHUP / Ctrl+C):
# leave a note for the next login, which opens Feedbacker with a report
# (feedback/report.py), and keep the kernel's lines from this session
# (a GPU reset or a driver error shows only there).
record_crash() {
    case "$1" in 0|129|130|143) return ;; esac
    printf '%s %s\n' "$(date +%s)" "$1" > "$logs/last-crash"
    kernel_log "$2"
}
kernel_log() {
    command -v journalctl >/dev/null && \
        journalctl -k -b 0 --since "@$1" --no-pager -o short-iso > "$logs/kernel-at-crash.log" 2>&1
}
# Wayfire, until it ends. Sonata's own build failing at once never locks you
# out, nor counts against the GPU choice or as a crash (Vini: the screen
# flickered three times, then a crash report): marked failed until it's built
# again, the system's Wayfire instead.
run_wayfire() {
    started=$(date +%s)
    "$WAYFIRE" -c "$cfg" > "$logs/session.log" 2>&1
    code=$?
    if [ "$WAYFIRE" != wayfire ] && [ "$code" -ne 0 ] && [ $(( $(date +%s) - started )) -lt 15 ]; then
        mv -f "$logs/session.log" "$logs/session.own-wayfire-failed.log"
        touch "$own/failed"
        WAYFIRE=wayfire
        started=$(date +%s)
        wayfire -c "$cfg" > "$logs/session.log" 2>&1
        code=$?
    fi
}
# The end of a session. A crash after it had been running a while starts
# Sonata again at once -- the same login, no password (Vini: a GPU reset
# took him back to the login screen) -- and Feedbacker then offers to reopen
# the apps (open_apps.py). At most RESTARTS times in RESTART_WINDOW seconds:
# a crash loop ends at the login screen as before.
RESTARTS=3
RESTART_WINDOW=600
finish() {
    local code=$1 ran=$(( $(date +%s) - $2 )) now recent t
    rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sonata2/adw/libadwaita.css"
    case "$code" in 0|129|130|143) exit "$code" ;; esac
    [ "$ran" -ge 20 ] && [ "${SONATA_NO_RESTART:-}" != 1 ] || exit "$code"
    now=$(date +%s); recent=""
    for t in ${SONATA_RESTART_TIMES:-}; do [ $(( now - t )) -lt $RESTART_WINDOW ] && recent="$recent $t"; done
    set -- $recent
    [ $# -lt $RESTARTS ] || exit "$code"
    export SONATA_RESTART_TIMES="$recent $now"
    case $- in *x*) exec bash -x "$SESSION_SCRIPT" ;; *) exec bash "$SESSION_SCRIPT" ;; esac
}
SESSION_SCRIPT="$(readlink -f "$0")"
if [ -n "$gpu_set" ]; then
    # a GPU order the session can't start with (driver trouble) must never
    # lock you out: Wayfire ending within seconds is started again without it
    run_wayfire
    ran_long=$(( $(date +%s) - started >= 15 ))
    if [ "$ran_long" = 1 ]; then record_crash "$code" "$started"; else kernel_log "$started"; fi
    # crashed because that GPU refused a buffer: back to wlroots' choice from
    # the next login, and the menu bar says so (gpu.crash_notice)
    # -- but not when an app filled the card's memory (NVRM NV_ERR_NO_MEMORY:
    # WhatsApp's web app with a video, Vini): that's no fault of the GPU choice
    if [ -n "$display_gpu" ] && [ "$code" -ne 0 ] && grep -qs -e "gbm_bo_create failed" -e "Failed to allocate auxilliary buffer" \
            "$logs/session.log" && ! grep -qs "NV_ERR_NO_MEMORY" "$logs/kernel-at-crash.log"; then
        rm -f "$gpu_flag"
        touch "$logs/display-gpu-crashed"
    fi
    if [ "$ran_long" = 1 ]; then
        finish "$code" "$started"
    fi
    mv -f "$logs/session.log" "$logs/session.gpu-failed.log"
    unset WLR_DRM_DEVICES
    # the last resort (wlroots' choice may be the other GPU): said once by the
    # menu bar (gpu.fallback_notice), never silently (Vini)
    printf '%s\n' "$(date +%s)" > "$logs/gpu-start-failed"
fi
run_wayfire
record_crash "$code" "$started"
# (finish: other desktops' GTK 4 apps never get Sonata's window look -- adwstyle.py)
finish "$code" "$started"
