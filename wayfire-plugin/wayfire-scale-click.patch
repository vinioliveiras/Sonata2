Sonata: a click on a window in Mission Control (scale) brings it forward
even where the scene's lookup finds no window under the pointer -- the
scaled window whose picture is there, or the one pressed (Vini: only
minimized windows came forward on a click).

--- a/plugins/scale/scale.cpp
+++ b/plugins/scale/scale.cpp
@@ -446,6 +446,32 @@
         }
     }
 
+    /* Sonata: the window under `at` -- the scene's lookup, else the scaled
+     * window whose picture is there. Vini: in Mission Control a click only
+     * brought a minimized window forward; on the others the lookup found
+     * nothing and the click did nothing. */
+    wayfire_toplevel_view scaled_view_at(wf::pointf_t at)
+    {
+        if (auto view = scale_find_view_at(at, output))
+        {
+            return view;
+        }
+
+        auto offset = wf::origin(output->get_layout_geometry());
+        wf::pointf_t local{at.x - offset.x, at.y - offset.y};
+        for (auto& e : scale_data)
+        {
+            if (!e.first->parent &&
+                (e.second.visibility == view_scale_data::view_visibility_t::VISIBLE) &&
+                (e.first->get_transformed_node()->get_bounding_box() & local))
+            {
+                return e.first;
+            }
+        }
+
+        return nullptr;
+    }
