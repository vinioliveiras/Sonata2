+    /* Sonata: tell sonata2 (ipc-rules' custom events) what was done to a
+     * window -- its menu asked for, a drag started or dropped; `at` in the
+     * output layout's coordinates. */
+    void sonata_event(const std::string& name, wayfire_toplevel_view view, wf::pointf_t at,
+        const std::string& state = "")
+    {
+        if (!view)
+        {
+            return;
+        }
+
+        wf::json_t data;
+        data["view-id"]   = (int)view->get_id();
+        data["app-id"]    = view->get_app_id();
+        data["output-id"] = (int)output->get_id();
+        data["output"]    = output->to_string();
+        data["x"] = at.x;
+        data["y"] = at.y;
+        if (!state.empty())
+        {
+            data["state"] = state;
+        }
+
+        wf::ipc_rules::send_event_to_subscribes(data, name);
+    }
