+    /* Sonata: a point of the window where it's drawn now (each transformer
+     * maps a point one level up: scale's among them), output-local */
+    static wf::pointf_t through_transformers(wayfire_toplevel_view view, wf::pointf_t p)
+    {
+        auto top = view->get_transformed_node().get();
+        for (wf::scene::node_t *n = view->get_surface_root_node()->parent(); n; n = n->parent())
+        {
+            p = n->to_global(p);
+            if (n == top)
+            {
+                break;
+            }
+        }
+
+        return p;
+    }
+
+    /* Sonata: the window under the pointer and where its frame is drawn now
+     * (output-local), when either changes -- sonata2 puts its close button
+     * there (sonata-scale-hover#; view-id -1: none). */
+    void sonata_hover(wayfire_toplevel_view view)
+    {
+        wf::geometry_t box = {0, 0, 0, 0};
+        if (view)
+        {
+            view = wf::find_topmost_parent(view);
+            auto g  = view->get_geometry();
+            auto tl = through_transformers(view, {1.0 * g.x, 1.0 * g.y});
+            auto br = through_transformers(view, {1.0 * g.x + g.width, 1.0 * g.y + g.height});
+            box = {(int)tl.x, (int)tl.y, (int)(br.x - tl.x), (int)(br.y - tl.y)};
+        }
+
+        if ((view == hovered) && (box == hovered_box))
+        {
+            return;
+        }
+
+        hovered = view;
+        hovered_box = box;
+        wf::json_t data;
+        data["view-id"] = view ? (int)view->get_id() : -1;
+        data["output"]  = output->to_string();
+        data["x"] = box.x;
+        data["y"] = box.y;
+        data["width"]  = box.width;
+        data["height"] = box.height;
+        wf::ipc_rules::send_event_to_subscribes(data, "sonata-scale-hover#");
     }
 
