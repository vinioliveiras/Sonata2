+/* Sonata (Vini: the dots were hard to hit): each button takes the clicks of
+ * the room around it, its picture unchanged -- half the gap to each
+ * neighbour (no dead space between them), the whole height of the title bar
+ * (so up to the window's top edge), and out to the window's side edge for
+ * the outermost one (edge_left / edge_right; -1: that side faces the title,
+ * where it keeps half a gap like the others). Resize handles still win at
+ * the frame (find_area_at checks them first). */
+void pixdecor_layout_t::set_button_hits(size_t first, double edge_left, double edge_right,
+    double top, double height)
+{
+    std::vector<decoration_area_t*> row;
+    for (size_t i = first; i < this->layout_areas.size(); i++)
+    {
+        if (this->layout_areas[i]->get_type() == DECORATION_AREA_BUTTON)
+        {
+            row.push_back(this->layout_areas[i].get());
+        }
+    }
+
+    std::sort(row.begin(), row.end(), [] (decoration_area_t *a, decoration_area_t *b)
+    {
+        return a->get_geometry().x < b->get_geometry().x;
+    });
+    for (size_t i = 0; i < row.size(); i++)
+    {
+        auto g = row[i]->get_geometry();
+        double gap_l = (i > 0) ?
+            (g.x - (row[i - 1]->get_geometry().x + row[i - 1]->get_geometry().width)) / 2.0 : -1;
+        double gap_r = (i + 1 < row.size()) ? (row[i + 1]->get_geometry().x - (g.x + g.width)) / 2.0 : -1;
+        double half  = (std::max(gap_l, gap_r) > 0) ? std::max(gap_l, gap_r) : 4;
+        double left  = (i == 0) ? ((edge_left >= 0) ? edge_left : g.x - half) : g.x - gap_l;
+        double right = (i + 1 == row.size()) ?
+            ((edge_right >= 0) ? edge_right : g.x + g.width + half) : g.x + g.width + gap_r;
+        double y0 = std::min<double>(top, g.y);
+        double y1 = std::max<double>(top + height, g.y + g.height);
+        int x = (int)std::floor(left), y = (int)std::floor(y0);
+        row[i]->set_hit({x, y, (int)std::ceil(right) - x, (int)std::ceil(y1) - y});
+    }
+}
